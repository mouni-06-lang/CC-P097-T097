# Azure Governance & Discovery Portal - Backend Environment Variables Example

# Backend Express Server Port
PORT=5000

# Azure Subscription ID (Replace with your subscription ID from `az account show`)
AZURE_SUBSCRIPTION_ID=51eaa99b-a883-4ed3-a1bb-882394f5553f

# Azure Tenant ID (Optional reference)
AZURE_TENANT_ID=808cc83e-a546-47e7-a03f-73a1ebba24f3
